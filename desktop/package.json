{
  "name": "hotel-aspect-ai-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Hotel Aspect AI native desktop application for macOS and Windows",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "desktop": "electron .",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:win": "electron-builder --win nsis",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.hotelaspect.qa",
    "productName": "Hotel Aspect AI",
    "directories": {
      "output": "../release"
    },
    "files": [
      "main.cjs",
      "app.py",
      "app.js",
      "index.html",
      "style.css",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../data/df/hotel_reviews.parquet",
        "to": "project/data/df/hotel_reviews.parquet"
      }
    ],
    "mac": {
      "identity": null,
      "category": "public.app-category.travel",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
